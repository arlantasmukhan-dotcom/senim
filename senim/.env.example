# ---- Required for the LLM steps (claim extraction, judge, re-interrogation, phantom twin)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Required for web evidence search (Alibi check). Free tier: 1000 searches/month
# Get a key at https://app.tavily.com  (without it SENIM falls back to Wikipedia only)
TAVILY_API_KEY=

# ---- Optional: models (any OpenRouter model id, see https://openrouter.ai/models)
# Main model: extracts claims and judges evidence. Needs to be strong and good at JSON.
SENIM_MODEL_MAIN=anthropic/claude-sonnet-5
# Cheap model for small classification jobs
SENIM_MODEL_FAST=anthropic/claude-haiku-4.5
# "Witnesses" for re-interrogation: use DIFFERENT model families (comma separated)
SENIM_WITNESSES=openai/gpt-6-luna,google/gemini-3.5-flash-lite,deepseek/deepseek-v4-flash

# ---- Optional: contact e-mail sent to Crossref / Wikimedia in the User-Agent (they ask for one)
SENIM_CONTACT_EMAIL=

# ---- Optional limits
SENIM_MAX_CLAIMS=12
SENIM_MAX_INPUT_CHARS=8000

# ---- Optional: shared cache + counters (Upstash Redis, free tier). Without it each server process keeps
# its own memory, which on Vercel is lost on every cold start. Vercel's KV_REST_API_URL/TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Abuse protection (every check costs money). 0 turns a limit off.
# Checks per visitor IP per hour (requests from this machine itself are never limited)
SENIM_RATE_LIMIT_PER_HOUR=20
# Stop accepting checks once today's model spend (UTC day) reaches this many dollars.
# Also set a hard credit limit on the key itself: https://openrouter.ai/settings/keys
SENIM_DAILY_BUDGET_USD=10
# Parallel model calls: per check, and across all checks in one server process
SENIM_LLM_CONCURRENCY=8
SENIM_LLM_GLOBAL_CONCURRENCY=48
# Skip the witness sensors when the sources already settle a claim (0 = always run every sensor)
SENIM_CASCADE=1

# ---- Optional: Telegram bot (python -m senim.bot). Token from @BotFather.
TELEGRAM_BOT_TOKEN=
